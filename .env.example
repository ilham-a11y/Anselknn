# Salin file ini menjadi .env lalu isi sesuai kondisi Anda.

# --- Database (MySQL/MariaDB, termasuk XAMPP) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tumbuhruang
# Isi true jika memakai database online yang mewajibkan SSL (mis. Vercel + TiDB/Aiven)
DB_SSL=false

# --- Keamanan ---
# Ganti dengan string acak panjang, mis. hasil dari: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# --- Server ---
PORT=3001
